{
  "info": {
    "name": "Finshot Remittance Transfer API",
    "description": "Scenarios S1-S6 plus extra checks. Start the app first with `go run ./src`, then run the requests in order (or use the Collection Runner).\n\nThe S1 Idempotency-Key is created once and reused, so sending S1 twice returns the same transfer (S2 and S3 use the same key). S4a always gets a fresh key, because S4 must create a new transfer to cancel. The last request ('Extra - Unknown customer') clears the S1 key, so the next run creates a new transfer without restarting the app. To start over by hand, clear keyS1 in the collection Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keyS1", "value": "" },
    { "key": "keyS4", "value": "" },
    { "key": "s1TransferId", "value": "" },
    { "key": "s4TransferId", "value": "" }
  ],
  "item": [
    {
      "name": "S1 - Create transfer C001 500000",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Create the key only once. Sending S1 again reuses it, so the server",
              "// treats it as a retry and returns the same transfer (no new data).",
              "// The last request of the collection clears it to start a new run.",
              "if (!pm.collectionVariables.get('keyS1')) {",
              "  pm.collectionVariables.set('keyS1', pm.variables.replaceIn('{{$guid}}'));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('s1TransferId', body.transferId);",
              "",
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('status REQUESTED', () => pm.expect(body.status).to.eql('REQUESTED'));",
              "pm.test('fee is 5000', () => pm.expect(body.fee).to.eql('5000'));",
              "pm.test('totalDebit is 505000', () => pm.expect(body.totalDebit).to.eql('505000'));",
              "pm.test('receiveAmount is 20600.00', () => pm.expect(body.receiveAmount).to.eql('20600.00'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{keyS1}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C001\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"500000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "S2 - Retry S1 (same key, same body)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('same transfer as S1', () => pm.expect(body.transferId).to.eql(pm.collectionVariables.get('s1TransferId')));",
              "pm.test('marked as replay', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{keyS1}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C001\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"500000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "S3 - Same key as S1, amount 600000",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('error is CONFLICT', () => pm.expect(pm.response.json().error).to.eql('CONFLICT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{keyS1}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C001\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"600000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "S4a - Create another transfer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// S4 must always be a NEW transfer that S4b can cancel,",
              "// so this request gets a fresh key on every send.",
              "pm.collectionVariables.set('keyS4', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('s4TransferId', body.transferId);",
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{keyS4}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C002\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"100000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Maria Santos\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "S4b - Cancel that transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/transfers/{{s4TransferId}}/cancel"
      }
    },
    {
      "name": "S5 - Cancel the same transfer again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', () => pm.response.to.have.status(409));",
              "pm.test('error is CONFLICT', () => pm.expect(pm.response.json().error).to.eql('CONFLICT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/transfers/{{s4TransferId}}/cancel"
      }
    },
    {
      "name": "S6 - Create with sendAmount 5000",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error is VALIDATION_ERROR', () => pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C001\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"5000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "Extra - Get transfer S1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('it is the S1 transfer', () => pm.expect(pm.response.json().transferId).to.eql(pm.collectionVariables.get('s1TransferId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/transfers/{{s1TransferId}}"
      }
    },
    {
      "name": "Extra - Get unknown transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error is NOT_FOUND', () => pm.expect(pm.response.json().error).to.eql('NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/transfers/does-not-exist"
      }
    },
    {
      "name": "Extra - Create without Idempotency-Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error is VALIDATION_ERROR', () => pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C001\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"500000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    },
    {
      "name": "Extra - Unknown customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "",
              "// End of the run: forget the S1 key so the next run creates a new transfer.",
              "pm.collectionVariables.set('keyS1', '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"C999\",\n  \"sendCurrency\": \"KRW\",\n  \"sendAmount\": \"500000\",\n  \"receiveCurrency\": \"PHP\",\n  \"recipientName\": \"Juan Dela Cruz\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/transfers"
      }
    }
  ]
}
